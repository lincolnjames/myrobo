# 실행에 필요한 환경변수 목록. 이 파일을 복사해 값을 채우되, 채운 파일은 커밋하지 않는다(.gitignore에 있음).
# Spring은 .env 파일을 자동으로 읽지 않으므로 터미널 환경변수나 IDE 실행 설정(Environment variables)으로 넣는다.

# Supabase → Project → Connect → Session pooler (IPv4 지원)
DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
DB_USER=postgres.<project-ref>
DB_PASSWORD=

# 규칙 설정 파일 위치 (기본값: config/robo-config.yml)
ROBO_CONFIG_PATH=config/robo-config.yml

# 데이터 소스 (수집 모듈을 만들 때부터 필요)
TIINGO_KEY=
FINNHUB_KEY=
KOREAEXIM_KEY=
SEC_USER_AGENT=myrobo your-email@example.com

# 알림 (주문안 모듈을 만들 때부터 필요)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
